USE ROLE AUTHBRIDGE_ADMIN;
USE DATABASE AUTHBRIDGE;
USE WAREHOUSE AUTHBRIDGE_AI_WH;

-- Pick a model available in your region / cross-region setting. Check the
-- AI_COMPLETE regional availability page, then update this row.
MERGE INTO AI.APP_CONFIG t USING (SELECT 'LLM_MODEL' AS key, 'claude-haiku-5-5' AS value) s ON t.key = s.key
  WHEN NOT MATCHED THEN INSERT (key, value) VALUES (s.key, s.value);

-- ---------------------------------------------------------------------------
-- Cortex Search services (hybrid retrieval with citations for the agents)
-- ---------------------------------------------------------------------------
-- Provider side: the patient's chart. Always filter on patient_id.
CREATE OR REPLACE CORTEX SEARCH SERVICE AI.CLINICAL_NOTES_SEARCH
  ON chunk_text
  ATTRIBUTES patient_id, note_type, doc_id
  WAREHOUSE = AUTHBRIDGE_AI_WH
  TARGET_LAG = '5 minutes'
  AS (
    SELECT d.doc_id, d.patient_id, d.note_type, d.title, d.encounter_date, c.value::STRING AS chunk_text
      FROM CORE.CLINICAL_DOCUMENT d,
           LATERAL FLATTEN(INPUT => SNOWFLAKE.CORTEX.SPLIT_TEXT_RECURSIVE_CHARACTER(d.text, 'none', 1500, 150)) c
  );

-- Payer side: only documents submitted with a PA request. Always filter on pa_id.
CREATE OR REPLACE CORTEX SEARCH SERVICE AI.SUBMITTED_DOCS_SEARCH
  ON chunk_text
  ATTRIBUTES pa_id, doc_id
  WAREHOUSE = AUTHBRIDGE_AI_WH
  TARGET_LAG = '1 minute'
  AS (
    SELECT s.pa_id, s.doc_id, s.title, s.encounter_date, c.value::STRING AS chunk_text
      FROM PAYER.SUBMITTED_DOCUMENT s,
           LATERAL FLATTEN(INPUT => SNOWFLAKE.CORTEX.SPLIT_TEXT_RECURSIVE_CHARACTER(s.text, 'none', 1500, 150)) c
  );

-- Payer medical policies, chunked by section for precise citations.
CREATE OR REPLACE CORTEX SEARCH SERVICE AI.POLICY_SEARCH
  ON chunk_text
  ATTRIBUTES policy_doc_id, service_code, section_id
  WAREHOUSE = AUTHBRIDGE_AI_WH
  TARGET_LAG = '1 hour'
  AS (
    SELECT chunk_id, policy_doc_id, service_code, section_id, section_title, chunk_text FROM AI.POLICY_DOC_CHUNKS
  );

-- ---------------------------------------------------------------------------
-- AI.SP_DTR_AUTOFILL(patient_id, items_json, doc_ids_json)
-- Provider side: propose DTR answers with verbatim evidence. Quotes are
-- verified here and again by the provider service.
-- ---------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE AI.SP_DTR_AUTOFILL(PATIENT_ID STRING, ITEMS STRING, DOC_IDS STRING)
RETURNS VARIANT
LANGUAGE PYTHON
RUNTIME_VERSION = '3.11'
PACKAGES = ('snowflake-snowpark-python')
HANDLER = 'run'
EXECUTE AS OWNER
AS
$$
import json

{{CRITERIA_ENGINE}}

{{SP_HELPERS}}

{{CORTEX_EXTRACT}}


def run(session, patient_id, items, doc_ids):
    items = json.loads(items)
    doc_ids = json.loads(doc_ids)
    notes = q(session,
              "SELECT doc_id, title, TO_VARCHAR(encounter_date) AS encounter_date, text FROM CORE.CLINICAL_DOCUMENT "
              "WHERE patient_id = ? AND ARRAY_CONTAINS(doc_id::VARIANT, PARSE_JSON(?))",
              [patient_id, json.dumps(doc_ids)])
    found, model = cortex_extract(session, items, notes)
    texts = {n["doc_id"]: n["text"] for n in notes}
    answers = {k: v for k, v in found.items() if verify_quote(v.get("quote"), texts.get(v.get("doc_id")))}
    session.sql(
        "INSERT INTO AI.AI_RECOMMENDATION_AUDIT (pa_id, agent_name, model, output, recommendation, ai_assisted) "
        "SELECT NULL, 'DTR_AUTOFILL', ?, PARSE_JSON(?), NULL, TRUE",
        params=[model, json.dumps({"patient_id": patient_id, "answers": answers,
                                   "rejected": sorted(set(found) - set(answers))})]).collect()
    return {"answers": answers, "model": model}
$$;

-- ---------------------------------------------------------------------------
-- AI.SP_AI_REVIEW(pa_id) — payer side: independently extract the criteria
-- facts from the *submitted* documents and compare with the provider's
-- answers. Disagreements are flagged for the reviewer; nothing is decided here.
-- ---------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE AI.SP_AI_REVIEW(PA_ID STRING)
RETURNS VARIANT
LANGUAGE PYTHON
RUNTIME_VERSION = '3.11'
PACKAGES = ('snowflake-snowpark-python')
HANDLER = 'run'
EXECUTE AS OWNER
AS
$$
import json

{{CRITERIA_ENGINE}}

{{SP_HELPERS}}

{{CORTEX_EXTRACT}}


def run(session, pa_id):
    pa = q(session, "SELECT * FROM PAYER.PA_REQUEST WHERE pa_id = ?", [pa_id])
    if not pa or not pa[0].get("policy_doc_id"):
        return {"skipped": True}
    pa = pa[0]
    leaves = [n for n in load_nodes(session, pa["policy_doc_id"]) if n["node_type"] == "LEAF"]
    items, seen = [], set()
    for n in leaves:
        if n["fact_name"] not in seen:
            seen.add(n["fact_name"])
            items.append({"linkId": n["fact_name"], "text": n["label"], "type": "decimal" if isinstance(n["threshold"], (int, float)) and not isinstance(n["threshold"], bool) else "boolean"})
    notes = q(session, "SELECT doc_id, title, TO_VARCHAR(encounter_date) AS encounter_date, text FROM PAYER.SUBMITTED_DOCUMENT WHERE pa_id = ?", [pa_id])
    if not notes:
        return {"skipped": True, "reason": "no documents"}
    found, model = cortex_extract(session, items, notes)
    qr = q(session, "SELECT answers FROM PAYER.QUESTIONNAIRE_RESPONSE WHERE pa_id = ? ORDER BY version DESC LIMIT 1", [pa_id])
    provider = (qr[0]["answers"] if qr else {}) or {}
    texts = {n["doc_id"]: n["text"] for n in notes}
    session.sql("DELETE FROM AI.AI_REVIEW_RESULT WHERE pa_id = ? AND version = ?", params=[pa_id, pa["version"]]).collect()
    for item in items:
        name = item["linkId"]
        ai = found.get(name) or {}
        prov = (provider.get(name) or {}).get("value")
        agrees = None if ai.get("value") is None or prov is None else str(ai["value"]).lower() == str(prov).lower()
        session.sql(
            "INSERT INTO AI.AI_REVIEW_RESULT (pa_id, version, fact_name, provider_value, ai_value, quote, doc_id, citation_verified, agrees, model) "
            "SELECT ?, ?, ?, PARSE_JSON(?), PARSE_JSON(?), ?, ?, ?, ?, ?",
            params=[pa_id, pa["version"], name, json.dumps(prov), json.dumps(ai.get("value")), ai.get("quote"), ai.get("doc_id"),
                    verify_quote(ai.get("quote"), texts.get(ai.get("doc_id"))), agrees, model]).collect()
    return {"pa_id": pa_id, "facts": len(items), "model": model}
$$;

-- ---------------------------------------------------------------------------
-- AI.SP_GET_CASE(pa_id) — read-only case summary used as an agent tool.
-- ---------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE AI.SP_GET_CASE(PA_ID STRING)
RETURNS VARIANT
LANGUAGE SQL
EXECUTE AS OWNER
AS
$$
BEGIN
  LET v VARIANT := (
    SELECT OBJECT_CONSTRUCT(
             'request', OBJECT_CONSTRUCT('pa_id', r.pa_id, 'service_code', r.service_code, 'service_display', r.service_display,
                                         'policy_doc_id', r.policy_doc_id, 'status', r.status, 'recommendation', r.recommendation,
                                         'reason_text', r.reason_text, 'priority', r.priority, 'member_id', r.member_id,
                                         'ordering_npi', r.ordering_npi, 'missing_info', r.missing_info, 'unmet', r.unmet),
             'criteria', r.criteria,
             'decisions', (SELECT ARRAY_AGG(OBJECT_CONSTRUCT('code', d.review_action_code, 'by', d.decided_by, 'role', d.decider_role,
                                                           'reason', d.reason_text, 'at', d.decided_at)) WITHIN GROUP (ORDER BY d.decided_at)
                             FROM PAYER.DECISION d WHERE d.pa_id = r.pa_id))
    FROM PAYER.PA_REQUEST r WHERE r.pa_id = :PA_ID);
  RETURN v;
END;
$$;
