USE ROLE AUTHBRIDGE_ADMIN;
USE DATABASE AUTHBRIDGE;
USE WAREHOUSE AUTHBRIDGE_APP_WH;

-- ---------------------------------------------------------------------------
-- PAYER.SP_PAS_SUBMIT(request_json) — called on Claim/$submit.
-- The service has already translated the PAS Bundle into a flat request:
-- {claim_id, related_pa_id, patient_id, member_id, ordering_npi, provider_org_npi,
--  service_code, code_system, service_display, icd10[], priority,
--  coverage_assertion_id, questionnaire_id, answers{fact:{value,quote,doc_id,origin}},
--  documents[{doc_id,title,encounter_date,text}]}
-- ---------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE PAYER.SP_PAS_SUBMIT(REQUEST STRING)
RETURNS VARIANT
LANGUAGE PYTHON
RUNTIME_VERSION = '3.11'
PACKAGES = ('snowflake-snowpark-python')
HANDLER = 'run'
EXECUTE AS OWNER
COMMENT = 'PAS: eligibility, rule, criteria tree, citations, decision, audit'
AS
$$
import json
import hashlib

{{CRITERIA_ENGINE}}

{{SP_HELPERS}}


def run(session, request):
    req = json.loads(request)
    member = q(session,
        "SELECT m.plan_id, p.line_of_business FROM PAYER.MEMBER_ELIGIBILITY m "
        "JOIN PAYER.PAYER_PLAN p ON p.plan_id = m.plan_id "
        "WHERE m.member_id = ? AND m.status = 'active' "
        "AND CURRENT_DATE() BETWEEN m.eff_start AND COALESCE(m.eff_end, '9999-12-31'::DATE)", [req["member_id"]])
    if not member:
        return {"error": "no-active-coverage", "message": "No active coverage for member %s" % req["member_id"]}
    plan_id, lob = member[0]["plan_id"], member[0]["line_of_business"]
    rule = q(session,
        "SELECT * FROM PAYER.SERVICE_PA_RULES WHERE service_code = ? AND (plan_id = ? OR plan_id IS NULL) "
        "AND CURRENT_DATE() >= effective_from AND (effective_to IS NULL OR CURRENT_DATE() <= effective_to) "
        "ORDER BY IFF(plan_id IS NULL, 1, 0) LIMIT 1", [req["service_code"], plan_id])
    rule = rule[0] if rule else None

    existing = None
    if req.get("related_pa_id"):
        rows = q(session, "SELECT * FROM PAYER.PA_REQUEST WHERE pa_id = ?", [req["related_pa_id"]])
        existing = rows[0] if rows else None
    pa_id = existing["pa_id"] if existing else "PA-%s" % scalar(session, "SELECT PAYER.SEQ_PA.NEXTVAL")
    version = (existing["version"] + 1) if existing else 1
    admin_ref = existing["admin_ref"] if existing else "REF-%s" % scalar(session, "SELECT PAYER.SEQ_REF.NEXTVAL")

    for d in req.get("documents", []):
        session.sql(
            "MERGE INTO PAYER.SUBMITTED_DOCUMENT t USING (SELECT ? AS pa_id, ? AS doc_id, ? AS title, "
            "TRY_TO_DATE(?) AS encounter_date, ? AS text) s ON t.pa_id = s.pa_id AND t.doc_id = s.doc_id "
            "WHEN MATCHED THEN UPDATE SET text = s.text, title = s.title "
            "WHEN NOT MATCHED THEN INSERT (pa_id, doc_id, title, encounter_date, text) "
            "VALUES (s.pa_id, s.doc_id, s.title, s.encounter_date, s.text)",
            params=[pa_id, d["doc_id"], d.get("title"), d.get("encounter_date"), d.get("text")]).collect()
    docs = {r["doc_id"]: r["text"] for r in q(session, "SELECT doc_id, text FROM PAYER.SUBMITTED_DOCUMENT WHERE pa_id = ?", [pa_id])}

    facts = {}
    for name, ans in (req.get("answers") or {}).items():
        facts[name] = dict(ans, verified=verify_quote(ans.get("quote"), docs.get(ans.get("doc_id"))))

    if not rule or not rule["pa_required"]:
        result = {"recommendation": AUTO_APPROVE, "reason_text": "Prior authorization is not required for this service.",
                  "criteria": [], "missing_info": [], "unmet": []}
    else:
        nodes = load_nodes(session, rule["policy_doc_id"])
        result = evaluate(nodes, facts)

    rec = result["recommendation"]
    status = {"AUTO_APPROVE": "APPROVED", "PEND": "PENDED", "RECOMMEND_DENY": "CLINICIAN_REVIEW"}[rec]
    sla_hours = 72 if req.get("priority") == "expedited" else 168

    if existing:
        session.sql(
            "UPDATE PAYER.PA_REQUEST SET status = ?, recommendation = ?, reason_text = ?, missing_info = PARSE_JSON(?), "
            "unmet = PARSE_JSON(?), criteria = PARSE_JSON(?), version = ?, updated_at = CURRENT_TIMESTAMP() WHERE pa_id = ?",
            params=[status, rec, result["reason_text"], json.dumps(result["missing_info"]), json.dumps(result["unmet"]),
                    json.dumps(result["criteria"]), version, pa_id]).collect()
    else:
        session.sql(
            "INSERT INTO PAYER.PA_REQUEST (pa_id, claim_id, patient_id, member_id, plan_id, line_of_business, ordering_npi, "
            "provider_org_npi, service_code, code_system, service_display, policy_doc_id, questionnaire_id, icd10_codes, "
            "priority, coverage_assertion_id, status, recommendation, reason_text, missing_info, unmet, criteria, admin_ref, "
            "version, submitted_at, sla_due_at, updated_at) "
            "SELECT ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, PARSE_JSON(?), ?, ?, ?, ?, ?, PARSE_JSON(?), PARSE_JSON(?), "
            "PARSE_JSON(?), ?, 1, CURRENT_TIMESTAMP(), DATEADD(hour, ?, CURRENT_TIMESTAMP()), CURRENT_TIMESTAMP()",
            params=[pa_id, req["claim_id"], req["patient_id"], req["member_id"], plan_id, lob, req.get("ordering_npi"),
                    req.get("provider_org_npi"), req["service_code"], req.get("code_system"), req.get("service_display"),
                    rule["policy_doc_id"] if rule else None, req.get("questionnaire_id"), json.dumps(req.get("icd10", [])),
                    req.get("priority", "standard"), req.get("coverage_assertion_id"), status, rec, result["reason_text"],
                    json.dumps(result["missing_info"]), json.dumps(result["unmet"]), json.dumps(result["criteria"]),
                    admin_ref, sla_hours]).collect()

    answers = req.get("answers") or {}
    auto = sum(1 for a in answers.values() if a.get("origin") == "auto")
    session.sql("INSERT INTO PAYER.QUESTIONNAIRE_RESPONSE (pa_id, version, answers, ai_prefill_pct) SELECT ?, ?, PARSE_JSON(?), ?",
                params=[pa_id, version, json.dumps(answers), (auto / len(answers)) if answers else 0]).collect()
    session.sql(
        "INSERT INTO AI.CLINICAL_REVIEW (pa_id, version, node_id, node_type, label, fact_name, fact_value, status, "
        "evidence_quote, evidence_doc_id, policy_section_id, citation_verified, origin) "
        "SELECT ?, ?, c.value:node_id::STRING, c.value:node_type::STRING, c.value:label::STRING, c.value:fact_name::STRING, "
        "c.value:value, c.value:status::STRING, c.value:quote::STRING, c.value:doc_id::STRING, "
        "c.value:policy_section_id::STRING, c.value:citation_verified::BOOLEAN, c.value:origin::STRING "
        "FROM TABLE(FLATTEN(INPUT => PARSE_JSON(?))) c",
        params=[pa_id, version, json.dumps(result["criteria"])]).collect()
    session.sql(
        "INSERT INTO AI.AI_RECOMMENDATION_AUDIT (pa_id, agent_name, model, policy_version, input_hash, output, recommendation, ai_assisted) "
        "SELECT ?, 'CRITERIA_ENGINE', 'deterministic', ?, ?, PARSE_JSON(?), ?, ?",
        params=[pa_id, rule["policy_doc_id"] if rule else None, hashlib.sha256(request.encode()).hexdigest(),
                json.dumps(result), rec, auto > 0]).collect()

    if rec == AUTO_APPROVE:
        decision = decide(session, pa_id, admin_ref, "A1", "SYSTEM", "SYSTEM", result["reason_text"])
    elif rec == PEND:
        decision = decide(session, pa_id, admin_ref, "A4", "SYSTEM", "SYSTEM", result["reason_text"],
                          "; ".join(result["missing_info"]))
    else:
        decision = decide(session, pa_id, admin_ref, "A4", "SYSTEM", "SYSTEM", "Pended for clinical review. " + result["reason_text"],
                          "A clinician is reviewing this request. No action is needed unless more records are available.")
    pa = q(session, "SELECT * FROM PAYER.PA_REQUEST WHERE pa_id = ?", [pa_id])[0]
    return result_of(pa, decision, result)
$$;

-- ---------------------------------------------------------------------------
-- PAYER.SP_RECORD_DECISION — clinician actions from the payer workbench.
-- Only MEDICAL_DIRECTOR may issue A3, with a named signer and a specific reason.
-- ---------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE PAYER.SP_RECORD_DECISION(
    PA_ID STRING, ACTION STRING, REVIEWER STRING, REVIEWER_ROLE STRING, REASON_TEXT STRING, REQUEST_TEXT STRING)
RETURNS VARIANT
LANGUAGE PYTHON
RUNTIME_VERSION = '3.11'
PACKAGES = ('snowflake-snowpark-python')
HANDLER = 'run'
EXECUTE AS OWNER
AS
$$
import json

{{SP_HELPERS}}


def run(session, pa_id, action, reviewer, role, reason_text, request_text):
    rows = q(session, "SELECT * FROM PAYER.PA_REQUEST WHERE pa_id = ? AND NOT is_historical", [pa_id])
    if not rows:
        raise ValueError("Unknown request %s" % pa_id)
    pa = rows[0]
    if action == "DENY":
        if role != "MEDICAL_DIRECTOR":
            raise PermissionError("Only a medical director can issue a denial (A3).")
        if not reviewer or not reason_text:
            raise ValueError("A denial needs a named signer and a specific reason.")
        status, code = "DENIED", "A3"
    elif action == "APPROVE":
        status, code = "APPROVED", "A1"
        reason_text = reason_text or "Approved after clinical review."
    elif action == "PEND":
        status, code = "PENDED", "A4"
        reason_text = reason_text or "More information requested."
        request_text = request_text or reason_text
    else:
        raise ValueError("action must be APPROVE, PEND or DENY")
    session.sql("UPDATE PAYER.PA_REQUEST SET status = ?, updated_at = CURRENT_TIMESTAMP() WHERE pa_id = ?",
                params=[status, pa_id]).collect()
    decision = decide(session, pa_id, pa["admin_ref"], code, reviewer, role, reason_text,
                      request_text if code == "A4" else None)
    session.sql(
        "INSERT INTO AI.AI_RECOMMENDATION_AUDIT (pa_id, agent_name, recommendation, output, ai_assisted, human_actor) "
        "SELECT ?, 'HUMAN', ?, PARSE_JSON(?), TRUE, ?",
        params=[pa_id, pa["recommendation"], json.dumps({"action": action, "reason": reason_text, "role": role}), reviewer]).collect()
    pa = q(session, "SELECT * FROM PAYER.PA_REQUEST WHERE pa_id = ?", [pa_id])[0]
    return result_of(pa, decision, None)
$$;

-- ---------------------------------------------------------------------------
-- PAYER.SP_COMPLETENESS — provider-side pre-check before submission (FR-4.6).
-- FACTS is a JSON object {fact: {value, quote, doc_id, verified, origin}}.
-- ---------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE PAYER.SP_COMPLETENESS(QUESTIONNAIRE_ID STRING, FACTS STRING)
RETURNS VARIANT
LANGUAGE PYTHON
RUNTIME_VERSION = '3.11'
PACKAGES = ('snowflake-snowpark-python')
HANDLER = 'run'
EXECUTE AS OWNER
AS
$$
import json

{{CRITERIA_ENGINE}}

{{SP_HELPERS}}


def run(session, questionnaire_id, facts):
    rows = q(session, "SELECT MAX(policy_doc_id) AS policy FROM PAYER.SERVICE_PA_RULES WHERE questionnaire_id = ?", [questionnaire_id])
    policy = rows[0]["policy"] if rows else None
    if not policy:
        return None
    result = evaluate(load_nodes(session, policy), json.loads(facts))
    result["policy_doc_id"] = policy
    return result
$$;

